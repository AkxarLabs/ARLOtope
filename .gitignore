# Local Lab state. Keep it on disk and back it up separately; it is not product source.
/lab/*
!/lab/README.md
!/lab/config.defaults.yaml
!/lab/profiles/
!/lab/notebook/
/lab/notebook/*
!/lab/notebook/README.md
!/lab/ideation/
/lab/ideation/*
!/lab/ideation/README.md
/studies/

# Project repositories normally live outside this checkout.
/arlotope-projects/
/projects/
/Projects/

# Credentials and machine-local settings. Example environment files may be shared.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
.claude/settings.local.json

# Generated docs, browser evidence and source-art previews.
/site/
/output/
/research/
/.cache/
dashboard/assets-src/
.playwright-cli/

# Language environments and development caches.
__pycache__/
*.pyc
.venv/
node_modules/
.pytmp/
.pytmp-*/
.pytest_cache/
.ruff_cache/

# OS metadata.
.DS_Store
Thumbs.db
